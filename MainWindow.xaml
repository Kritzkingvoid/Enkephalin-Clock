<Window x:Class="EnkephalinClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnkephalinClock"
        mc:Ignorable="d"
        Title="MainWindow" Height="255" Top="50" Width="400"
        AllowsTransparency="True"
        Topmost="True"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Viewbox  x:Name="MainView"  Stretch="Uniform">
        <Grid x:Name="TitleBar" Width="400" Height="255" ClipToBounds="False" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseMove="TitleBar_MouseMove" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
            <Grid x:Name="AnnounceContainer" Height="51" Width="312" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed" Margin="40,70,0,0" ClipToBounds="False">
                <Grid x:Name="ImageContainer"
                        Height="51"
                        Width="311"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        ClipToBounds="True">
                    <Image x:Name="ContainerImage"  Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Grid>
                <Grid x:Name="MarqueeContainer"
                                Height="51"
                                Width="289"
                                ClipToBounds="True"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="10,0,0,0">
                    <Canvas x:Name="MarqueeCanvas" Height="22">
                        <TextBlock x:Name="MarqueeTextBlock"
                                FontFamily="pack://application:,,,/Font/# EXCELSIOR SANS"
                                Foreground="#ffffa1"
                                FontSize="25"
                                VerticalAlignment="Center"
                                TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="MarqueeTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Grid>
                <Grid x:Name="ImageContainerOuter"
                     Height="51"
                     Width="311"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     ClipToBounds="False">
                    <Image x:Name="ImageOuterImage" Stretch="Fill" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Grid>
            </Grid>

            <Grid x:Name="QualiCounter" VerticalAlignment="Center" HorizontalAlignment="Left" Width="325" Height="40" Margin="26,0,0,-10" Visibility="Visible">
                <Border Background="#130406"
                    BorderBrush="#ff3839"
                    BorderThickness="1"
                    Padding="2"
                    Margin="91,5,63,6">
                    <ItemsControl x:Name="MeltDownBar">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200"
                                    Height="50"
                                    Margin="1"
                                    CornerRadius="1"
                                    Background="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Image x:Name="MeltDownImage"
                    Stretch="Fill"
                    Margin="-10,-3,-56,-6"/>
                <Image x:Name="StatusDay"
                    Stretch="Fill"
                    Opacity="0.9"
                    Margin="10,8,294,10"
                    Source="/Images/ManagementUISun.png"
                    MouseLeftButtonDown="StatusDay_MouseLeftButtonDown">
                    <Image.Triggers>
                        <EventTrigger RoutedEvent="Image.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever"
                            AutoReverse="True">
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="Opacity"
                                        From="0.5"
                                        To="1.0"
                                        Duration="0:0:3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Image.Triggers>
                </Image>
                <TextBlock x:Name="MinutesCount"
                    Text="6"
                    FontSize="35"
                    FontFamily="pack://application:,,,/Font/# EXCELSIOR SANS"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Foreground="#ff3839"
                    TextAlignment="Center" Margin="294,0,0,0" 
                    MouseLeftButtonDown="MinutesCount_MouseLeftButtonDown"/>
                <TextBlock x:Name="RomanNumeral"
                    Text="6"
                    FontSize="30"
                    Opacity="1.0"
                    FontFamily="pack://application:,,,/Font/# EXCELSIOR SANS"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="#fe9142"
                    TextAlignment="Center" Margin="47,0,0,0"/>
            </Grid>
            <Grid VerticalAlignment="Center"  HorizontalAlignment="Left" Width="325" Height="40" Margin="10,0,0,0">
                <Image x:Name="CityImage" MouseLeftButtonDown="CityImage_MouseLeftButtonDown" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="22,0,0,0" Height="85" Width="332"/>
                <ProgressBar x:Name="EnkephalinBar"
                    Minimum="0"
                    Maximum="60" Margin="30,0,0,5"
                    Background="#130406"
                    Foreground="#29f5a5"/>
                <TextBlock x:Name="SecondsCount"
                    Text="0 / 60"
                    FontSize="25"
                    FontFamily="pack://application:,,,/Font/# EXCELSIOR SANS"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="#ff3839"
                    TextAlignment="Center" Grid.ColumnSpan="2" Margin="138,0,0,0"/>
                <Image x:Name="EnkephalinImage" Margin="4,-30,-53,-16">

                </Image>
            </Grid>
  
        </Grid>
        
    </Viewbox>

</Window>
